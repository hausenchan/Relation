{
  "name": "relation-manager",
  "version": "1.0.0",
  "private": true,
  "description": "客户关系与人才管理系统",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "ai-suggestions:sync": "node server/scripts/sync-ai-suggestions.js",
    "wolai:import": "node scripts/wolai-importer/import-wolai-docs.js",
    "wolai:collect": "node scripts/wolai-collector/collect-wolai-chrome.js",
    "wolai:chrome": "node scripts/wolai-collector/start-chrome-debug.js",
    "mobile-task:collect": "node scripts/mobile-task-center-collector.js",
    "mobile-task:validate": "node scripts/mobile-task-center-collector.js --validate-config",
    "performance:api": "node scripts/performance-audit.js",
    "performance:frontend": "node scripts/check-frontend-performance-budget.js",
    "db:migrate:mysql": "node scripts/migrate-sqlite-to-mysql.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "imapflow": "^1.3.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.8",
    "mammoth": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "node-cron": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "sync-rpc": "^1.3.7"
  }
}
