{
  "name": "relation-manager",
  "version": "1.0.0",
  "private": true,
  "description": "客户关系与人才管理系统",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "ai-suggestions:sync": "node server/scripts/sync-ai-suggestions.js",
    "mobile-task:collect": "node scripts/mobile-task-center-collector.js",
    "mobile-task:validate": "node scripts/mobile-task-center-collector.js --validate-config",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "imapflow": "^1.3.3",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.8",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1"
  }
}
