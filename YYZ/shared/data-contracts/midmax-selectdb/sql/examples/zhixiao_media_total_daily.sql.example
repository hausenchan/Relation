SELECT
  CAST(stat_date AS DATE) AS `日期`,
  CAST(media_id AS CHAR) AS `媒体ID`,
  media_name AS `媒体名称`,
  visit_uv AS `访问uv`,
  apply_uv AS `申请uv`,
  completed_uv AS `完成uv`,
  estimated_revenue AS `预估收入`,
  media_cost AS `媒体成本`,
  estimated_profit AS `预估毛利`,
  order_count AS `订单数`
FROM __AUDITED_SELECTDB_VIEW_ZHIXIAO_MEDIA_TOTAL_DAILY__
WHERE stat_date >= :start_date
  AND stat_date <= :end_date
ORDER BY stat_date, visit_uv DESC
LIMIT :limit
