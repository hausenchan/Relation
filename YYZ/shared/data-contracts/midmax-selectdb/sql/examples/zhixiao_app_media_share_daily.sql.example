SELECT
  CAST(stat_date AS DATE) AS `日期`,
  CAST(app_id AS CHAR) AS `小程序ID`,
  app_name AS `小程序名称`,
  CAST(media_id AS CHAR) AS `媒体ID`,
  media_name AS `媒体`,
  visit_uv AS `访问uv`,
  order_count AS `订单数`,
  ad_click_count AS `广告点击数`,
  ad_request_count AS `广告请求数`,
  ad_impression_count AS `广告曝光数`
FROM __AUDITED_SELECTDB_VIEW_ZHIXIAO_APP_MEDIA_SHARE_DAILY__
WHERE stat_date >= :start_date
  AND stat_date <= :end_date
ORDER BY stat_date, app_name, order_count DESC
LIMIT :limit
